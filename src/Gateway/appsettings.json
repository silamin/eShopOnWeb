{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "publicapi",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "monolith": {
        "ClusterId": "web",
        "Order": 2,
        "Match": { "Path": "/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "publicapi": {
        "Destinations": { "d1": { "Address": "http://eshoppublicapi:8080/" } }
      },
      "web": {
        "Destinations": { "d1": { "Address": "http://eshopwebmvc:8080/" } }
      }
    }
  }
}
