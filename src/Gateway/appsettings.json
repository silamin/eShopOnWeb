{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": { "PermitLimit": 100, "WindowSeconds": 10 },
  "ReverseProxy": {
    "Routes": {
      "catalog-items-write": {
        "RateLimiterPolicy": "api",
        "ClusterId": "catalog",
        "Order": -1,
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/catalog-items/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-items": {
        "RateLimiterPolicy": "api",
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-items/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-brands": {
        "RateLimiterPolicy": "api",
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-brands/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-types": {
        "RateLimiterPolicy": "api",
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-types/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "inventory": {
        "RateLimiterPolicy": "api",
        "ClusterId": "inventory",
        "Order": 0,
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "orders": {
        "RateLimiterPolicy": "api",
        "ClusterId": "ordering",
        "Order": 0,
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "api": {
        "RateLimiterPolicy": "api",
        "ClusterId": "publicapi",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "publicapi-swagger": {
        "ClusterId": "publicapi",
        "Order": 1,
        "Match": { "Path": "/swagger/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "monolith": {
        "ClusterId": "web",
        "Order": 2,
        "Match": { "Path": "/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "d1": { "Address": "http://catalogservice:8080/" },
          "d2": { "Address": "http://catalogservice-2:8080/" }
        }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://inventoryservice:8080/" } }
      },
      "ordering": {
        "Destinations": { "d1": { "Address": "http://orderingservice:8080/" } }
      },
      "publicapi": {
        "Destinations": { "d1": { "Address": "http://eshoppublicapi:8080/" } }
      },
      "web": {
        "Destinations": { "d1": { "Address": "http://eshopwebmvc:8080/" } }
      }
    }
  }
}
