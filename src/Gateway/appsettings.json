{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-items-write": {
        "ClusterId": "catalog",
        "Order": -1,
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/catalog-items/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-items": {
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-items/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-brands": {
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-brands/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "catalog-types": {
        "ClusterId": "catalog",
        "Order": 0,
        "Match": { "Path": "/api/catalog-types/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "api": {
        "ClusterId": "publicapi",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "publicapi-swagger": {
        "ClusterId": "publicapi",
        "Order": 1,
        "Match": { "Path": "/swagger/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "monolith": {
        "ClusterId": "web",
        "Order": 2,
        "Match": { "Path": "/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalogservice:8080/" } }
      },
      "publicapi": {
        "Destinations": { "d1": { "Address": "http://eshoppublicapi:8080/" } }
      },
      "web": {
        "Destinations": { "d1": { "Address": "http://eshopwebmvc:8080/" } }
      }
    }
  }
}
