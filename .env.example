# Copy this file to .env before `docker compose up`:   cp .env.example .env
# .env is in .gitignore and is never committed. The values below are placeholders that make a clean clone
# run for a demo; put your own random ones in .env, e.g.
#   JWT_KEY:  openssl rand -hex 32          passwords:  openssl rand -hex 16   (SQL needs upper+lower+digit+symbol: add "-Aa1")
# A value left blank or missing makes `docker compose` stop with "copy .env.example to .env".

# SQL Server (azure-sql-edge): password of the sa login. Only the monolith and the Public API use sa
# (they create and migrate their own databases); each new service has its own login, below.
SQL_SA_PASSWORD=Change-Me-Sa-1234-Aa1

# Catalog service: password of its own SQL login (catalog_svc), which reaches only eShop.CatalogServiceDb.
CATALOG_DB_PASSWORD=Change-Me-Catalog-1234-Aa1

# Inventory service: password of its own SQL login (inventory_svc), which reaches only eShop.InventoryDb.
INVENTORY_DB_PASSWORD=Change-Me-Inventory-1234-Aa1

# Ordering service: password of its own SQL login (ordering_svc), which reaches only eShop.OrderingDb.
ORDERING_DB_PASSWORD=Change-Me-Ordering-1234-Aa1

# JWT signing key (HS256). The same value is read by the token issuers (monolith, Public API) and by the
# validators (Public API, gateway, Catalog, Inventory and Ordering services). At least 32 characters.
JWT_KEY=change-me-jwt-signing-key-at-least-32-characters-long

# RabbitMQ: the only broker user (the default "guest" user is not created) and its own virtual host.
RABBITMQ_USER=eshop
RABBITMQ_PASSWORD=change-me-rabbit-1234
RABBITMQ_VHOST=eshop
